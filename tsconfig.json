{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "react": ["./app/node_modules/@types/react"],
      "react/*": ["./app/node_modules/@types/react/*"],
      "react/jsx-runtime": ["./app/node_modules/@types/react/jsx-runtime"],
      "framer-motion": ["./app/node_modules/framer-motion"],
      "@/*": ["./app/*"]
    }
  },
  "include": [
    "CalendarWeekView.tsx",
    "LandingHero.tsx"
  ]
}
