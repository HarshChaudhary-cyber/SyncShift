# SyncShift Backend Environment Configuration
# =================================================

# Environment Mode (development | production | staging)
ENV=development

# Database Connection (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite:///./syncshift.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syncshift

# JWT Secret & Secret Key
# This dev default is intentionally insecure and will be rejected by the app if ENV=production.
# Generate a real secret for production, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=syncshift-dev-secret-key-32-chars-minimum!!
SECRET_KEY=syncshift-dev-secret-key-32-chars-minimum!!

# AI Assistant (Google Gemini API Key for smart assistant tools)
GEMINI_API_KEY=
AI_PROVIDER=gemini

# OAuth Provider Configuration (Google & Microsoft)
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Bot Protection / CAPTCHA (Cloudflare Turnstile)
CAPTCHA_SECRET_KEY=
CAPTCHA_ENFORCE=false

# Push Notifications (WebPush VAPID keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@syncshift.app

# Email / SMTP Settings (Optional for email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@syncshift.app

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
